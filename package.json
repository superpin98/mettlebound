{
  "name": "mettlebound",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@babylonjs/core": "^9.7.0",
    "@babylonjs/gui": "^9.7.0",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/inspector": "^9.7.0",
    "@babylonjs/loaders": "^9.7.0",
    "@babylonjs/materials": "^9.7.0",
    "i18next": "^26.2.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.11",
    "zod": "^4.4.3"
  }
}
